  --wht: #FFFFFF;
  --blk: #0D0D0D;
}

body{
  background:#1a1a1a;
  font-family:'Sarabun',sans-serif;
  padding:30px 16px 60px;
}

h1.page-title{
  text-align:center;
  font-family:'Russo One',sans-serif;
  font-size:clamp(1.4rem,4vw,2.2rem);
  color:#fff;
  margin-bottom:6px;
  letter-spacing:0.06em;
}
.page-sub{
  text-align:center;
  font-size:0.8rem;
  color:rgba(253,184,39,0.7);
  letter-spacing:0.18em;
  margin-bottom:36px;
  text-transform:uppercase;
}

/* ── DESIGN CARD ── */
.design-block{
  max-width:900px;
  margin:0 auto 56px;
}
.design-title{
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:20px;
}
.design-num{
  font-family:'Russo One',sans-serif;
  font-size:2.2rem;
  color:var(--org);
  line-height:1;
}
.design-name{
  flex:1;
}
.design-name h2{
  font-family:'Teko',sans-serif;
  font-size:1.6rem;
  letter-spacing:0.08em;
  color:#fff;
  line-height:1;
}
.design-name p{
  font-size:0.75rem;
  color:rgba(255,255,255,0.45);
  margin-top:2px;
}
.shirts-row{
  display:flex;
  gap:24px;
  justify-content:center;
  flex-wrap:wrap;
}
.shirt-wrap{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:8px;
}
.shirt-wrap span{
  font-size:0.7rem;
  letter-spacing:0.2em;
  color:rgba(253,184,39,0.6);
  text-transform:uppercase;
  font-family:'Rajdhani',sans-serif;
}
svg.shirt{
  width:min(360px,88vw);
  filter:drop-shadow(0 12px 40px rgba(0,0,0,0.6));
}
.divider{
  height:1px;
  background:linear-gradient(90deg,transparent,rgba(244,98,42,0.4),transparent);
  margin:10px 0 0;
}

